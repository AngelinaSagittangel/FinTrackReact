generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TransactionType {
  income
  expense
}

enum WalletType {
  cash
  card
  savings
  investment
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())

  wallets    Wallet[]
  categories Category[]
  budgets    Budget[]
}

model Wallet {
  id             String     @id @default(uuid())
  name           String
  type           WalletType
  initialBalance Decimal    @db.Decimal(12, 2)
  createdAt      DateTime   @default(now())

  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  outgoingTransfers Transfer[] @relation("TransferFromWallet")
  incomingTransfers Transfer[] @relation("TransferToWallet")
}

model Category {
  id        String          @id @default(uuid())
  name      String
  color     String
  type      TransactionType
  createdAt DateTime        @default(now())

  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  budgets      Budget[]
}

model Transaction {
  id          String          @id @default(uuid())
  amount      Decimal         @db.Decimal(12, 2)
  type        TransactionType
  date        DateTime
  description String?
  createdAt   DateTime        @default(now())

  walletId   String
  wallet     Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
}

model Budget {
  id        String   @id @default(uuid())
  amount    Decimal  @db.Decimal(12, 2)
  month     Int
  year      Int
  createdAt DateTime @default(now())

  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
}

model Transfer {
  id        String   @id @default(uuid())
  amount    Decimal  @db.Decimal(12, 2)
  date      DateTime
  createdAt DateTime @default(now())

  fromWalletId String
  fromWallet   Wallet @relation("TransferFromWallet", fields: [fromWalletId], references: [id], onDelete: Cascade)

  toWalletId String
  toWallet   Wallet @relation("TransferToWallet", fields: [toWalletId], references: [id], onDelete: Cascade)
}